# Ce dossier est servi par DEUX hotes (voir hPanel > Sous-domaines) :
#   thatmuch.fr/audit-refonte/   -> URL canonique de l'outil
#   audit-refonte.thatmuch.fr/   -> ancien sous-domaine, conserve pour les liens
#                                   externes, redirige en 301 vers le canonique
#
# La condition sur HTTP_HOST est indispensable : sans elle, la regle
# s'appliquerait aussi a l'URL canonique et creerait une boucle de redirection.
# Le $1 preserve le chemin demande (/refonte-form/ reste /refonte-form/).
RewriteEngine On
RewriteCond %{HTTP_HOST} ^audit-refonte\.thatmuch\.fr$ [NC]
RewriteRule ^(.*)$ https://thatmuch.fr/audit-refonte/$1 [R=301,L]

# Les images Open Graph (P2-3) sont generees par la convention Next
# opengraph-image.tsx, qui produit un fichier SANS extension (le PNG genere
# s'appelle litteralement "opengraph-image"). Sur un serveur Node, Next fixe
# lui-meme l'en-tete Content-Type ; ici Apache sert un fichier statique et
# n'a que le nom pour se guider, ce qui le sert par defaut en text/plain ou
# application/octet-stream. Les crawlers de partage (Facebook notamment)
# verifient strictement ce Content-Type et ignorent l'image sinon.
<Files "opengraph-image">
  ForceType image/png
</Files>
